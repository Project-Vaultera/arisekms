# syntax=docker/dockerfile:1

# ---------- Build stage ----------
FROM node:26.13.1-bookworm-slim AS builder

WORKDIR /usr/src/app

# Skip husky hooks (no .git in the build context) and Playwright browser
# downloads (test-only; they would bloat the build).
ENV HUSKY=0 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Install lockfile-exact dependencies first for better layer caching.
COPY package.json package-lock.json ./
RUN npm ci

# Compile TypeScript: src/ -> dist/src, migrations/ + ormconfig.ts -> dist/.
COPY . .

ARG APP_ENV=production
ENV NODE_ENV=${APP_ENV}

RUN npm run build \
 && test -f dist/ormconfig.js \
 && test -d dist/migrations

# Keep only production dependencies in the runtime image.
RUN npm prune --omit=dev

# ---------- Runtime stage ----------
FROM node:26.13.1-bookworm-slim AS runtime

WORKDIR /usr/src/app

ENV NODE_ENV=production \
    APP_ENV=production

COPY --chown=node:node --from=builder /usr/src/app/package.json /usr/src/app/package-lock.json ./
COPY --chown=node:node --from=builder /usr/src/app/node_modules ./node_modules
COPY --chown=node:node --from=builder /usr/src/app/dist ./dist
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

# Uploaded files live on a volume; the app runs as the unprivileged `node` user.
RUN chmod +x /usr/local/bin/docker-entrypoint.sh \
 && mkdir -p /usr/src/app/uploads \
 && chown -R node:node /usr/src/app/uploads

USER node

EXPOSE 3006

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.APP_PORT||3006)+'/api/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["npm", "run", "start:prod"]
