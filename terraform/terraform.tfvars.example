# Copy to terraform.tfvars (git-ignored) and fill in. Never commit real values.

aws_region = "ap-south-1"

# Request a certificate in ACM for the domain, add the validation CNAME in
# Cloudflare (DNS only), then paste the ARN here. The ALB cannot serve HTTPS
# without it.
acm_certificate_arn = "arn:aws:acm:ap-south-1:000000000000:certificate/00000000-0000-0000-0000-000000000000"

# Everything below is optional; the defaults are sized for a demo deployment.

# project     = "arisekms"
# environment = "prod"
# image_tag   = "latest" # pin a git SHA to roll both services back

# api_cpu     = 512
# api_memory  = 1024
# web_cpu     = 256
# web_memory  = 512

# The auth throttle counts in process memory, so this is validated to stay at 1.
# api_desired_count = 1
# web_desired_count = 1

# db_instance_class         = "db.t4g.micro"
# db_allocated_storage      = 20
# db_multi_az               = false
# db_backup_retention_days  = 7

# app_secret_name = "arisekms/prod/app"
# cors_origins    = ""

# github_repo                 = "Project-Vaultera/arisekms"
# create_github_oidc_provider = true
