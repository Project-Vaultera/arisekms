{
	email {$ACME_EMAIL}

	# Uncomment to dry-run certificates against Let's Encrypt staging:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# One site block handles the SPA and the API on the same origin, so the
# browser never needs CORS. `DOMAIN` may list several names separated by
# whitespace (e.g. "example.com www.example.com"); Caddy issues a
# certificate for each name.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# OpenAPI docs. Must precede the general API rule: `handle` blocks are
	# exclusive and first-match, so `/api/*` would otherwise swallow this. The
	# app only mounts the schema with APP_ENV=development, so in production this
	# path reaches the app and 404s there — delete the block to stop proxying it
	# at the edge, or drop `handle /api/v1/swagger*` in favour of publishing.
	handle /api/v1/swagger* {
		reverse_proxy app:{$APP_PORT:3006}
	}

	# NestJS API. Health probe: /api/v1/health
	handle /api/* {
		reverse_proxy app:{$APP_PORT:3006}
	}

	# Built SPA with client-side routing fallback.
	handle {
		root * /srv

		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
		}

		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
