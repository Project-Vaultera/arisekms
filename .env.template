# Development environment. Copy to .env, then run:
#
#   cp .env.template .env
#   node scripts/init-env.mjs .env
#   docker compose up -d
#
# Every value the API reads on first boot is here. Nothing here is a secret
# except the four marked SECRET, and those are generated — not chosen. A value
# left empty that the app needs fails at container start, naming the variable.
#
# Read by: `app` (the API container) unless marked otherwise. `.env` is the only
# env file any process loads; `docker-compose.yml` names it explicitly.

# --- Application ---------------------------------------------------------
# development enables Swagger, DB query logging and free seeding. The API
# rejects anything else.
APP_ENV=development
# Port the API listens on inside the container and publishes on the host.
APP_PORT=3006
# Browser origin used to build password-reset and invite links. Must match the
# frontend URL you actually open, or every mailed link 404s.
APP_PUBLIC_URL=http://localhost:5176

# --- Database ------------------------------------------------------------
# Postgres host:port as the API reaches it. compose overrides DB_HOST to the
# service name `pgsqldb`; use `pgsqldb`, not `localhost`, from inside Compose.
DB_HOST=pgsqldb
DB_PORT=5432
DB_NAME=example_db
DB_USER=root
# SECRET, generated by scripts/init-env.mjs. A Postgres volume keeps the
# password it was first initialised with, so changing this on an existing
# volume means `docker compose down -v`.
DB_PASS=

# --- Authentication ------------------------------------------------------
# SECRET, generated by scripts/init-env.mjs. An RS256 keypair; RS256 is forced,
# so an HS256 secret will not do.
JWT_PUBLIC_KEY_BASE64=
JWT_PRIVATE_KEY_BASE64=
JWT_ACCESS_TOKEN_EXP_IN_SEC=3600
JWT_REFRESH_TOKEN_EXP_IN_SEC=7200

# --- Seeding -------------------------------------------------------------
# Password given to `it-admin` by `npm run cli:dev`. Must satisfy 1 uppercase,
# 1 lowercase, 1 digit, 1 symbol, 12-120 chars, or seeding refuses.
DEFAULT_ADMIN_USER_PASSWORD=Arise@2026

# --- Mail (all read only in development; resets land in Mailpit) ---------
# smtp = Mailpit inbox, log = links in the API log. There is no real delivery.
MAIL_TRANSPORT=smtp
# compose overrides this to `mailpit`; change only to use a different catcher.
MAIL_SMTP_HOST=mailpit
MAIL_SMTP_PORT=1025
MAIL_FROM="Arise KMS <no-reply@arise.local>"

# --- Host ports ----------------------------------------------------------
FRONTEND_PORT=5176
# Browse the dev inbox here for reset and invite mail.
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1026
ADMINER_PORT=8086
# Host port for Postgres. Inside Compose the API still uses DB_PORT above.
PGSQL_HOST_PORT=5436

# --- Frontend (read by the `frontend` container, not the API) ------------
# Browser-facing API URL. Must not be the in-Compose host `app`. Vite inlines
# it, so changing it needs `docker compose up -d --force-recreate frontend`.
VITE_API_URL=http://localhost:3006/api/v1

# --- Tests ---------------------------------------------------------------
# Host the e2e suite connects to from the dev container.
TEST_DB_HOST=pgsqldb