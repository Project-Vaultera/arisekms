# Production environment for docker-compose.prod.yml.
# Copy to .env.production on the server, fill in real values, then:
#   chmod 600 .env.production
# NEVER commit .env.production.

# --- Edge / TLS -----------------------------------------------------------
# To include www, list both names separated by a space, e.g.
#   DOMAIN="example.com www.example.com"
# (Caddy rejects "example.com,www.example.com" — put a space after the comma.)
DOMAIN=example.com
ACME_EMAIL=ops@example.com

# --- Application ----------------------------------------------------------
APP_PORT=3006
# Relative URL: Caddy proxies /api/* on the same origin (no CORS).
VITE_API_URL=/api/v1
# Must match the public origin(s), including www if used.
CORS_ORIGINS=https://example.com

# --- Database -------------------------------------------------------------
DB_NAME=arisekms
DB_USER=arisekms
# Generate with: openssl rand -hex 32  (hex avoids $/#/space parsing issues)
DB_PASS=CHANGE_ME_before_deploy

# --- Authentication -------------------------------------------------------
# Generate the key pair with ./scripts/generate-jwt-keys and paste both values.
JWT_ACCESS_TOKEN_EXP_IN_SEC=3600
JWT_REFRESH_TOKEN_EXP_IN_SEC=7200
JWT_PUBLIC_KEY_BASE64=
JWT_PRIVATE_KEY_BASE64=
DEFAULT_ADMIN_USER_PASSWORD=CHANGE_ME_before_deploy

# --- Images ---------------------------------------------------------------
# CI deploys :latest; set a :<git-sha> tag here to pin or roll back.
API_IMAGE=ghcr.io/project-vaultera/arisekms-api:latest
WEB_IMAGE=ghcr.io/project-vaultera/arisekms-web:latest
